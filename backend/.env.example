# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
# backend/.env is gitignored — never commit real credentials.

# --- Server ---
# Port the Go API listens on. Required: there is no default in code, so leaving this
# empty makes the server bind an arbitrary free port. Must match NEXT_PUBLIC_API_URL
# in frontend/.env.local.
PORT=8080
# "development" or "production". Logged at boot.
ENV=development

# --- Required: the server exits at boot if either of these is empty ---
# PostgreSQL connection string. Credentials must match the POSTGRES_* values
# that Docker Compose starts the database with (see .env at the repo root).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xclone?sslmode=disable
# Secret used to sign session JWTs. Generate one, don't reuse this placeholder:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# --- Optional: media uploads ---
# Without all three CLOUDINARY_* values the app still runs, but avatar and post
# photo uploads answer 503. The server prints a warning at boot.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder prefix for uploaded assets.
CLOUDINARY_UPLOAD_FOLDER=xclone
